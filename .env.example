GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Configurações da OCI

# As config comentadas é apenas para o teste local
# OCI_ENDPOINT="http://localhost:12000"
# OCI_NAMESPACE="namespace_ficticio"

# Substitua pelo nome do Bucket real que você criou no console da OCI
BUCKET_NAME="nome-teste-bucket"

# Deixe em branco para que o script descubra automaticamente via API, 
# ou insira o seu Namespace real da OCI para otimizar as chamadas
OCI_NAMESPACE=""

# Caminho explícito para o arquivo de configuração real criado
OCI_CONFIG_FILE="~/.oci/config"
OCI_PROFILE="DEFAULT"

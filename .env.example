GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Configurações da OCI
OCI_ENDPOINT="http://localhost:12000"
OCI_NAMESPACE="namespace_ficticio"
BUCKET_NAME="seu_bucket_de_testes"

# (Opcional) Caso queira forçar o caminho do config explicitamente no SDK
OCI_CONFIG_FILE="~/.oci/config"
OCI_PROFILE="DEFAULT"

# RAG Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu  

# ChromaDB
CHROMA_COLLECTION_NAME=novamente_documents
CHROMA_PERSIST_DIRECTORY=.data/chroma